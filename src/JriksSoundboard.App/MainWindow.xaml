<Window x:Class="JriksSoundboard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JriksSoundboard.App"
        xmlns:board="clr-namespace:JriksSoundboard.Core.Board;assembly=JriksSoundboard.Core"
        Title="Jrik's Soundboard"
        Width="1280" Height="860" MinWidth="1020" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource WindowBase}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ───────── Top bar ───────── -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Jrik's Soundboard" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,16,0">
                <Ellipse x:Name="StatusDot" Width="10" Height="10" Margin="0,0,8,0" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Click="OnStopAll" Margin="0,0,8,0" ToolTip="Stop every sound that's playing">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" Margin="0,0,8,0" />
                        <TextBlock Text="Stop all" />
                    </StackPanel>
                </Button>
                <Button Click="OnOpenSettings" ToolTip="Audio, microphone, wheel, overlay and hotkey settings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Margin="0,0,8,0" />
                        <TextBlock Text="Settings" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ───────── Content ───────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Library -->
            <Border Style="{StaticResource Card}" AllowDrop="True" DragOver="OnLibraryDragOver" Drop="OnLibraryDrop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <TextBlock x:Name="LibraryCount" DockPanel.Dock="Right" Style="{StaticResource Hint}" Margin="0" VerticalAlignment="Center" />
                        <TextBlock Text="Library" Style="{StaticResource SectionTitle}" Margin="0" />
                    </DockPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,10">
                        <Button Click="OnAddSounds" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,8,0" />
                                <TextBlock Text="Add sounds…" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnAddFolder">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Margin="0,0,8,0" />
                                <TextBlock Text="Add folder…" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" />
                        <TextBlock x:Name="SearchPlaceholder" Text="Search sounds" IsHitTestVisible="False" Margin="12,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </Grid>

                    <Grid Grid.Row="3">
                        <ListBox x:Name="LibraryList" HorizontalContentAlignment="Stretch"
                                 SelectionChanged="OnLibrarySelectionChanged"
                                 PreviewMouseLeftButtonDown="OnLibraryPreviewMouseDown"
                                 MouseMove="OnLibraryMouseMove"
                                 MouseDoubleClick="OnLibraryDoubleClick"
                                 KeyDown="OnLibraryKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type board:SoundItem}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Click="OnPreviewSound" Tag="{Binding}" Padding="7,4" Margin="0,0,10,0"
                                                ToolTip="Preview in your headphones (the game doesn't hear it)">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12" />
                                        </Button>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding DurationText}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                <Setter Property="Text" Value="⚠ file missing" />
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <Ellipse Grid.Column="2" Width="8" Height="8" Margin="8,0,4,0" ToolTip="On a wheel"
                                                 Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                                 Visibility="{Binding IsOnWheel, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="LibraryEmptyHint" Style="{StaticResource Hint}" TextAlignment="Center"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"
                                   Text="Drag audio files or whole folders here,&#x0a;or use “Add sounds…”.&#x0a;&#x0a;mp3 · wav · ogg · flac · m4a · wma" />
                    </Grid>

                    <!-- Selected sound -->
                    <Border x:Name="SoundDetails" Grid.Row="4" Margin="0,12,0,0" Padding="0,12,0,0"
                            BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <StackPanel>
                            <TextBox x:Name="SoundNameBox" LostFocus="OnSoundNameLostFocus" KeyDown="OnSoundNameKeyDown" ToolTip="Rename" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Volume" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Slider x:Name="SoundVolumeSlider" Grid.Column="1" Minimum="0" Maximum="200" VerticalAlignment="Center"
                                        ValueChanged="OnSoundVolumeChanged" />
                                <TextBlock x:Name="SoundVolumeText" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="SoundPathText" Style="{StaticResource Hint}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="Play in game" Click="OnPlaySelectedInGame" Margin="0,0,8,0" />
                                <Button Content="Show file" Click="OnShowFile" Margin="0,0,8,0" />
                                <Button Content="Remove" Click="OnRemoveSound" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Wheels -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid x:Name="WheelsPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <Button DockPanel.Dock="Right" Click="OnNewWheel" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,8,0" />
                                <TextBlock Text="New wheel" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Wheels" Style="{StaticResource SectionTitle}" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <ListBox x:Name="WheelTabs" SelectionChanged="OnWheelTabChanged" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type board:WheelDefinition}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="  ·  " Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{Binding HotkeyName}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- Wheel header -->
                    <Grid Grid.Row="1" Margin="0,14,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="WheelNameBox" Grid.Column="1" LostFocus="OnWheelNameLostFocus" KeyDown="OnWheelNameKeyDown" />
                        <TextBlock Grid.Column="2" Text="Slices" VerticalAlignment="Center" Margin="16,0,8,0" />
                        <ComboBox x:Name="SliceCountBox" Grid.Column="3" SelectionChanged="OnSliceCountChanged" />
                        <TextBlock Grid.Column="4" Text="Hotkey" VerticalAlignment="Center" Margin="16,0,8,0" />
                        <TextBlock x:Name="WheelHotkeyText" Grid.Column="5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Grid.Column="6" Content="Change…" Click="OnChangeWheelHotkey" />
                        <Button Grid.Column="8" Click="OnDeleteWheel" ToolTip="Delete this wheel">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" />
                        </Button>
                    </Grid>

                    <!-- Editor -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="270" />
                        </Grid.ColumnDefinitions>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button x:Name="BackButton" Click="OnFolderBack" Margin="0,0,10,0" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72B;" Margin="0,0,8,0" />
                                        <TextBlock Text="Back" />
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="BreadcrumbText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="Both" Margin="0,8">
                                <local:WheelView x:Name="EditorWheel" Width="480" Height="480" />
                            </Viewbox>
                            <TextBlock Grid.Row="2" Style="{StaticResource Hint}" TextAlignment="Center" Margin="0"
                                       Text="Drag a sound from the library onto a slice · drag a slice onto another to swap · double-click a sound to drop it into the selected slice" />
                        </Grid>

                        <!-- Slot details -->
                        <Border Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="16,6,0,0">
                            <StackPanel>
                                <TextBlock x:Name="SlotTitle" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="SlotContent" TextWrapping="Wrap" />

                                <StackPanel x:Name="SlotSoundActions" Margin="0,14,0,0" Visibility="Collapsed">
                                    <Button Content="Preview" Click="OnSlotPreview" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                                    <Button Content="Clear slot" Click="OnSlotClear" HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <StackPanel x:Name="SlotFolderActions" Margin="0,14,0,0" Visibility="Collapsed">
                                    <TextBlock Text="Folder name" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                    <TextBox x:Name="FolderNameBox" LostFocus="OnFolderNameLostFocus" KeyDown="OnFolderNameKeyDown" />
                                    <Button Content="Open folder" Click="OnOpenFolder" HorizontalAlignment="Stretch" Margin="0,12,0,8" />
                                    <Button Content="Remove folder" Click="OnRemoveFolder" HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <StackPanel x:Name="SlotEmptyActions" Margin="0,14,0,0" Visibility="Collapsed">
                                    <Button x:Name="MakeFolderButton" Content="Turn into a folder" Click="OnMakeFolder" HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource Hint}" Margin="0,24,0,0"
                                           Text="Folders hold a second wheel. In game, rest on a folder for a moment and it opens; flick again to pick inside it." />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ───────── Now playing ───────── -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="NowPlayingText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <ProgressBar x:Name="NowPlayingProgress" Grid.Column="1" Height="6" Maximum="100" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
