<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\JriksSoundboard.Core\JriksSoundboard.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>JriksSoundboard</AssemblyName>
    <RootNamespace>JriksSoundboard.App</RootNamespace>
    <!-- Exe icon (Explorer, taskbar). Generated by tools/make_icon.py. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same icon for the window title bars (see WindowBase style in App.xaml). -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
