<Window x:Class="JriksSoundboard.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JriksSoundboard.App"
        Title="Soundboard overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        ResizeMode="NoResize" Width="400" Height="480">
    <Grid x:Name="Root">
        <!-- Full name of the slice you're pointing at (slice labels get shortened on busy wheels). -->
        <Border x:Name="NameChip" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0"
                Padding="16,7" CornerRadius="15" Background="#E6141418" Visibility="Hidden">
            <TextBlock x:Name="NameText" Foreground="White" FontSize="15" FontWeight="SemiBold"
                       TextAlignment="Center" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis" />
        </Border>

        <local:WheelView x:Name="Wheel" IsOverlayStyle="True" Width="380" Height="380"
                         VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,64,0,0" />

        <Border x:Name="TimerPill" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10"
                Padding="18,10" CornerRadius="16" Background="#E6141418" Visibility="Collapsed">
            <StackPanel Width="250">
                <TextBlock x:Name="TimerText" Foreground="White" FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <ProgressBar x:Name="TimerBar" Height="4" Maximum="100" Margin="0,8,0,0" />
                <TextBlock x:Name="TimerHint" Text="keep holding push-to-talk" Foreground="#B3FFFFFF" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,5,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
