<Window x:Class="JriksSoundboard.App.KeyCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set a hotkey"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource WindowBase}">
    <StackPanel Margin="24" Width="420">
        <TextBlock Text="Press a key" FontSize="20" FontWeight="SemiBold" />
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,10,0,0" />
        <TextBlock Style="{StaticResource Hint}"
                   Text="Keyboard keys and mouse buttons (except left click) both work. Pick something CS2 doesn't use — mouse side buttons are ideal. Esc cancels." />
        <Button Content="Cancel" IsCancel="True" HorizontalAlignment="Right" Margin="0,18,0,0" Click="OnCancel" />
    </StackPanel>
</Window>
